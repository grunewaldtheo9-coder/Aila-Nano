# ==========================================================
# Aila Nano 2.0 — environment configuration template
# ==========================================================
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored; NEVER commit real keys or credentials.

# -- Model / engine ----------------------------------------
# (defaults shown; uncomment to override)
#AILA_CHECKPOINT=checkpoints/finetune/best.pt
#AILA_FALLBACK_CHECKPOINT=checkpoints/pretrain/best.pt
#AILA_TOKENIZER=tokenizer/artifacts/aila_nano.model
#AILA_DEVICE=auto
#AILA_DEFAULT_AGENT=general

# -- Memory / knowledge storage ----------------------------
#AILA_MEMORY_DB=memory/data/aila_memory.db
#AILA_MEMORY_FAISS=memory/data/aila_memory.faiss
#AILA_KNOWLEDGE_DB=vectordb/index/knowledge.db
#AILA_KNOWLEDGE_FAISS=vectordb/index/knowledge.faiss
# Global knowledge base + web research cache (SQLite):
#AILA_KNOWLEDGE_STORE_DB=knowledge/data/aila_knowledge.db
# Storage backend for the knowledge store: "sqlite" (default, local,
# fully supported) or "firestore" (requires firebase-admin +
# GOOGLE_APPLICATION_CREDENTIALS service-account JSON; see
# docs/CONFIGURATION.md).
#AILA_STORAGE_BACKEND=sqlite

# -- Firebase (only needed when AILA_STORAGE_BACKEND=firestore) --
# Path to a Firebase service-account JSON file (server-side credential;
# NOT the browser firebaseConfig snippet — that one is for web clients
# and cannot authenticate a Python backend).
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#AILA_FIREBASE_PROJECT_ID=your-project-id

# -- Web research (Serper) ---------------------------------
# Get a key at https://serper.dev — keep it ONLY here, never in code.
#SERPER_API_KEY=your-serper-api-key-here
#AILA_WEB_SEARCH_ENABLED=true
#AILA_WEB_MAX_RESULTS=5
#AILA_WEB_TIMEOUT_SECONDS=8
# Cache TTL for verified web knowledge, in hours (stable facts):
#AILA_WEB_CACHE_TTL_HOURS=168

# -- Wikipedia (free, no API key, no account, no quota) ----
# Aila's default source. On unless you turn it off — it is what keeps
# her able to look things up when no Serper key is set, or when a key
# stops working. Uses AILA_WEB_TIMEOUT_SECONDS for its timeout.
#AILA_WIKIPEDIA_ENABLED=true
#AILA_WIKIPEDIA_MAX_RESULTS=3

# -- Self-directed study -----------------------------------
# Once a day at startup, Aila looks up a few things she previously
# failed to answer, so she knows more each day and can answer them
# offline afterwards. Bounded: at most this many lookups per day.
#AILA_DAILY_STUDY=true
#AILA_STUDY_TOPICS_PER_DAY=3

# -- Freeform generation -----------------------------------
# Off by default. Anything the deterministic layer can't handle gets an
# honest "here's what I can do" instead of generated text, because at
# ~20M parameters generation is measurably noise (docs/BENCHMARKS.md).
# Set true to let the model try anyway.
#AILA_ALLOW_FREEFORM=false

# -- Translation (Portuguese <-> English) ------------------
# On by default. When a Portuguese question can't be answered natively
# (Portuguese Wikipedia has no article, a memory was stored in English),
# it is translated to English, answered from the larger English sources,
# and the answer is translated back. Purely additive — it never changes
# a good native Portuguese answer. Needs deep-translator + internet;
# degrades to a no-op without them.
#AILA_TRANSLATE=true

# -- Curated knowledge seed --------------------------------
# On by default. Loads the hand-checked general-knowledge facts in
# knowledge/seed/*.jsonl (capitals, science, maths, in English and
# Portuguese) into the knowledge base at startup, so Aila answers common
# questions directly and correctly, offline, with no API key. Idempotent
# and skipped when the seed files are unchanged.
#AILA_SEED_KNOWLEDGE=true

# -- Retrieval ---------------------------------------------
#AILA_RETRIEVAL_TOP_K=3
#AILA_RELEVANCE_THRESHOLD=0.2
