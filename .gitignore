# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv*/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- ML artifacts ---
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.ckpt
checkpoints/**/tb/
!checkpoints/.gitkeep
runs/
tensorboard/
*.log

# --- Tokenizer artifacts ---
tokenizer/artifacts/*.model
tokenizer/artifacts/*.vocab
!tokenizer/artifacts/.gitkeep

# --- Datasets (raw/processed data is fetched, not committed) ---
datasets/raw/
datasets/processed/
datasets/cache/
!datasets/sample/
!datasets/aila_knowledge/

# --- Vector DB / memory ---
vectordb/index/*.faiss
vectordb/index/*.pkl
!vectordb/index/.gitkeep
memory/data/*.db
memory/data/*.sqlite3
!memory/data/.gitkeep

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# Aila 2.0 global knowledge store (runtime data, not source)
knowledge/data/*.db
knowledge/data/*.sqlite3
!knowledge/data/.gitkeep
