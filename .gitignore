# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv*/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- ML artifacts ---
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.ckpt
# training/checkpoint.py writes atomically (tmp file + rename). A commit
# made while a save is in flight otherwise sweeps up a ~223 MB *.pt.tmp,
# which GitHub rejects outright — the push fails with a size-limit error
# that says nothing about a temp file.
checkpoints/**/*.tmp
checkpoints/**/tb/
!checkpoints/.gitkeep
runs/
tensorboard/
*.log

# --- Tokenizer artifacts ---
tokenizer/artifacts/*.model
tokenizer/artifacts/*.vocab
!tokenizer/artifacts/.gitkeep
# Candidate tokenizers are regenerable experiments (train_tokenizer_candidates.py);
# ignore their binaries. The chosen v2 bilingual tokenizer under
# tokenizer/artifacts/v2_bilingual/ IS committed (small, and the deliverable).
tokenizer/artifacts/candidates/**/*.model
tokenizer/artifacts/candidates/**/*.vocab
# Derived tokenizer-training text corpus (regenerate with build_tokenizer_corpus.py).
datasets/tokenizer_corpus/

# --- Datasets (raw/processed data is fetched, not committed) ---
datasets/raw/
datasets/processed/
datasets/cache/
!datasets/sample/
!datasets/aila_knowledge/
# Versioned corpora: keep the manifest + README (provenance/reproducibility),
# ignore the derived token .bin shards (regenerated by build_pretrain_corpus.py).
datasets/pretrain/**/*.bin
datasets/instruction/**/*.bin
datasets/aila/**/*.bin
# Data-scaling experiment checkpoints are large; the JSON results + report
# under experiments/ are committed, the .pt checkpoints are not.
checkpoints/50m_data_scaling/

# --- Vector DB / memory ---
vectordb/index/*.faiss
vectordb/index/*.pkl
vectordb/index/*.db
!vectordb/index/.gitkeep
memory/data/*.db
memory/data/*.sqlite3
memory/data/*.faiss
!memory/data/.gitkeep

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# Aila 2.0 global knowledge store (runtime data, not source)
knowledge/data/*.db
knowledge/data/*.sqlite3
!knowledge/data/.gitkeep
datasets/conversational/split/

# v2 bilingual experiment checkpoints (large .pt; JSON results under experiments/ are committed)
checkpoints_v2/
# bounded raw slices used to build corpora
datasets/raw/tinystories_slice.txt
